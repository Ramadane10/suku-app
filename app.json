{
  "expo": {
    "name": "Nwanma",
    "slug": "nwanma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Nwanma-icon-app.png",
    "scheme": "nwanma",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/Nwanma-chargement-app.png",
      "resizeMode": "cover",
      "backgroundColor": "#1B4332"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Nwanma-icon-app.png",
        "backgroundColor": "#1B4332"
      },
      "splash": {
        "image": "./assets/images/Nwanma-chargement-app.png",
        "resizeMode": "cover",
        "backgroundColor": "#1B4332"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.mramadane.nwanma"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/Nwanma-transparent.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Nwanma-chargement-app.png",
          "resizeMode": "cover",
          "backgroundColor": "#1B4332",
          "enableFullScreenImage_legacy": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "26d0e89e-c0d0-49a5-9622-5caff6ea9e95"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/26d0e89e-c0d0-49a5-9622-5caff6ea9e95"
    }
  }
}